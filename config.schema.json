{
  "pluginAlias": "homebridge-garage-control",
  "pluginType": "platform",
  "headerDisplay": "Homebridge plugin zur Steuerung eines Garagentors über HTTP-Anfragen.",
  "footerDisplay": "Für weitere Informationen besuchen Sie: <a href='https://github.com/krebbi/homebridge-garage-control' target='_blank'>GitHub Repository</a>",
  "schema": {
    "type": "object",
    "required": ["name", "openURL", "closeURL"],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Garagentor",
        "description": "Name des Garagentors in HomeKit"
      },
      "openURL": { "type": "string", "title": "Öffnen URL", "format": "uri", "description": "URL zum Öffnen des Garagentors" },
      "closeURL": { "type": "string", "title": "Schließen URL", "format": "uri", "description": "URL zum Schließen des Garagentors" },
      "statusURL": { "type": "string", "title": "Status URL", "format": "uri", "description": "URL zur Statusabfrage des Garagentors" },
      "openTime": { "type": "integer", "title": "Öffnungszeit (Sekunden)", "default": 10, "description": "Zeit zum Öffnen des Garagentors in Sekunden" },
      "closeTime": { "type": "integer", "title": "Schließzeit (Sekunden)", "default": 10, "description": "Zeit zum Schließen des Garagentors in Sekunden" },
      "switchOff": { "type": "boolean", "title": "Switch-Off aktivieren", "default": false, "description": "Switch-Off Funktion aktivieren" },
      "switchOffDelay": { "type": "integer", "title": "Switch-Off Verzögerung (Sekunden)", "default": 2, "description": "Verzögerung für Switch-Off in Sekunden" },
      "autoLock": { "type": "boolean", "title": "Auto-Lock aktivieren", "default": false, "description": "Auto-Lock Funktion aktivieren" },
      "autoLockDelay": { "type": "integer", "title": "Auto-Lock Verzögerung (Sekunden)", "default": 20, "description": "Verzögerung für Auto-Lock in Sekunden" },
      "polling": { "type": "boolean", "title": "Status-Abfrage aktivieren", "default": false, "description": "Status-Abfrage aktivieren" },
      "pollInterval": { "type": "integer", "title": "Abfrageintervall (Sekunden)", "default": 120, "description": "Intervall für Status-Abfrage in Sekunden" },
      "http_method": {
        "type": "string",
        "title": "HTTP-Methode",
        "default": "GET",
        "enum": ["GET", "POST", "PUT", "PATCH"],
        "description": "HTTP-Methode für Anfragen"
      },
      "timeout": { "type": "integer", "title": "Timeout (Millisekunden)", "default": 3000, "description": "Timeout für HTTP-Anfragen in Millisekunden" },
      "manufacturer": { "type": "string", "title": "Hersteller", "default": "DIY", "description": "Hersteller des Garagentors" },
      "model": { "type": "string", "title": "Modell", "default": "GarageDoorControl", "description": "Modellbezeichnung des Garagentors" },
      "serial": { "type": "string", "title": "Seriennummer", "default": "1.0.0", "description": "Seriennummer des Garagentors" },
      "firmware": { "type": "string", "title": "Firmware-Version", "default": "1.0.0", "description": "Firmware-Version des Garagentors" },
      "openStatusValues": {
        "type": "string",
        "title": "Statuswerte für 'offen'",
        "default": "0,2,open,offen",
        "description": "Statuswerte, die als geöffnet interpretiert werden, kommagetrennt, z.B. 0,2,open,offen"
      },
      "closedStatusValues": {
        "type": "string",
        "title": "Statuswerte für 'geschlossen'",
        "default": "1,3,closed,geschlossen",
        "description": "Statuswerte, die als geschlossen interpretiert werden, kommagetrennt, z.B. 1,3,closed,geschlossen"
      },
      "username": { "type": "string", "title": "Benutzername", "description": "Optional: Benutzername für HTTP-Authentifizierung" },
      "password": { "type": "string", "title": "Passwort", "description": "Optional: Passwort für HTTP-Authentifizierung", "format": "password" }
    }
  },
  "layout": [
    "name",
    {
      "title": "URLs",
      "type": "fieldset",
      "expandable": true,
      "expanded": false,
      "items": ["openURL", "closeURL", "statusURL"]
    },
    {
      "title": "Zeiten & Funktionen",
      "type": "fieldset",
      "expandable": true,
      "expanded": false,
      "items": ["openTime", "closeTime", "switchOff", "switchOffDelay", "autoLock", "autoLockDelay"]
    },
    {
      "title": "Status & HTTP",
      "type": "fieldset",
      "expandable": true,
      "expanded": false,
      "items": ["polling", "pollInterval", "http_method", "timeout"]
    },
    {
      "title": "Geräteinfos",
      "type": "fieldset",
      "expandable": true,
      "expanded": false,
      "items": ["manufacturer", "model", "serial", "firmware"]
    },
    {
      "title": "Statuswerte",
      "type": "fieldset",
      "expandable": true,
      "expanded": false,
      "items": ["openStatusValues", "closedStatusValues"]
    },
    {
      "title": "Authentifizierung",
      "type": "fieldset",
      "expandable": true,
      "expanded": false,
      "items": ["username", "password"]
    }
  ]
}
