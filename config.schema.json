{
  "pluginAlias": "GarageDoorControl",
  "pluginType": "accessory",
  "singular": true,
  "headerDisplay": "Homebridge plugin zur Steuerung eines Garagentors über HTTP-Anfragen.",
  "footerDisplay": "Für weitere Informationen besuchen Sie: <a href='https://github.com/krebbi/homebridge-garage-control' target='_blank'>GitHub Repository</a>",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Garagentor",
        "required": true,
        "description": "Name des Garagentors in HomeKit"
      },
      "openURL": {
        "title": "Öffnen URL",
        "type": "string",
        "format": "uri",
        "required": true,
        "description": "URL, die aufgerufen wird, um das Tor zu öffnen"
      },
      "closeURL": {
        "title": "Schließen URL",
        "type": "string",
        "format": "uri",
        "required": true,
        "description": "URL, die aufgerufen wird, um das Tor zu schließen"
      },
      "statusURL": {
        "title": "Status URL",
        "type": "string",
        "format": "uri",
        "description": "Optional: URL, die aufgerufen wird, um den Status des Tors abzufragen (erfordert Polling)"
      },
      "openTime": {
        "title": "Öffnungszeit (Sekunden)",
        "type": "integer",
        "minimum": 1,
        "maximum": 60,
        "default": 10,
        "description": "Zeit in Sekunden, die das Tor zum Öffnen benötigt"
      },
      "closeTime": {
        "title": "Schließzeit (Sekunden)",
        "type": "integer",
        "minimum": 1,
        "maximum": 60,
        "default": 10,
        "description": "Zeit in Sekunden, die das Tor zum Schließen benötigt"
      },
      "switchOff": {
        "title": "Switch-Off aktivieren",
        "type": "boolean",
        "default": false,
        "description": "Nach dem Öffnen einen zusätzlichen Befehl senden (z.B. um den Motor auszuschalten)"
      },
      "switchOffDelay": {
        "title": "Switch-Off Verzögerung (Sekunden)",
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "default": 2,
        "description": "Verzögerung vor dem Senden des Switch-Off Befehls"
      },
      "autoLock": {
        "title": "Auto-Lock aktivieren",
        "type": "boolean",
        "default": false,
        "description": "Das Tor nach einer bestimmten Zeit automatisch schließen"
      },
      "autoLockDelay": {
        "title": "Auto-Lock Verzögerung (Sekunden)",
        "type": "integer",
        "minimum": 5,
        "maximum": 300,
        "default": 20,
        "description": "Zeit in Sekunden, nach der das Tor automatisch geschlossen wird"
      },
      "polling": {
        "title": "Status-Abfrage aktivieren",
        "type": "boolean",
        "default": false,
        "description": "Periodische Abfrage des Garagentor-Status (erfordert statusURL)"
      },
      "pollInterval": {
        "title": "Abfrageintervall (Sekunden)",
        "type": "integer",
        "minimum": 5,
        "maximum": 600,
        "default": 120,
        "description": "Intervall für die Status-Abfrage in Sekunden"
      },
      "http_method": {
        "title": "HTTP-Methode",
        "type": "string",
        "default": "GET",
        "oneOf": [
          { "title": "GET", "enum": ["GET"] },
          { "title": "POST", "enum": ["POST"] },
          { "title": "PUT", "enum": ["PUT"] }
        ],
        "description": "HTTP-Methode für Anfragen"
      },
      "timeout": {
        "title": "Timeout (Millisekunden)",
        "type": "integer",
        "minimum": 1000,
        "maximum": 30000,
        "default": 3000,
        "description": "Timeout für HTTP-Anfragen in Millisekunden"
      },
      "username": {
        "title": "Benutzername (optional)",
        "type": "string",
        "description": "Benutzername für HTTP Basic Authentication"
      },
      "password": {
        "title": "Passwort (optional)",
        "type": "string",
        "format": "password",
        "description": "Passwort für HTTP Basic Authentication"
      },
      "manufacturer": {
        "title": "Hersteller",
        "type": "string",
        "default": "DIY",
        "description": "Name des Herstellers (für HomeKit-Informationen)"
      },
      "model": {
        "title": "Modell",
        "type": "string",
        "default": "GarageDoorControl",
        "description": "Modellbezeichnung (für HomeKit-Informationen)"
      },
      "serial": {
        "title": "Seriennummer",
        "type": "string",
        "default": "1.0.0",
        "description": "Seriennummer (für HomeKit-Informationen)"
      },
      "firmware": {
        "title": "Firmware-Version",
        "type": "string",
        "default": "1.0.0",
        "description": "Firmware-Version (für HomeKit-Informationen)"
      }
    }
  },
  "form": [
    {
      "type": "help",
      "helpvalue": "<h3>Grundeinstellungen</h3>"
    },
    "name",
    {
      "type": "fieldset",
      "title": "URLs",
      "expandable": true,
      "items": [
        "openURL",
        "closeURL",
        "statusURL"
      ]
    },
    {
      "type": "fieldset",
      "title": "Zeiteinstellungen",
      "expandable": true,
      "items": [
        "openTime",
        "closeTime"
      ]
    },
    {
      "type": "help",
      "helpvalue": "<h3>Erweiterte Funktionen</h3>"
    },
    {
      "type": "fieldset",
      "title": "Auto-Lock Konfiguration",
      "expandable": true,
      "items": [
        "autoLock",
        {
          "key": "autoLockDelay",
          "condition": "model.autoLock === true"
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Switch-Off Konfiguration",
      "expandable": true,
      "items": [
        "switchOff",
        {
          "key": "switchOffDelay",
          "condition": "model.switchOff === true"
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Status-Abfrage",
      "expandable": true,
      "items": [
        "polling",
        {
          "key": "pollInterval",
          "condition": "model.polling === true"
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "HTTP-Konfiguration",
      "expandable": true,
      "items": [
        "http_method",
        "timeout",
        "username",
        "password"
      ]
    },
    {
      "type": "fieldset",
      "title": "Geräteinformationen",
      "expandable": true,
      "items": [
        "manufacturer",
        "model",
        "serial",
        "firmware"
      ]
    }
  ]
}
